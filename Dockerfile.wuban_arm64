# 构建参数
ARG LITELLM_BUILD_IMAGE=python:3.11.8-slim
ARG LITELLM_RUNTIME_IMAGE=python:3.11.8-slim

# 缓存阶段 - 用于缓存 pip 依赖
FROM ${LITELLM_BUILD_IMAGE} AS builder-cache
WORKDIR /cache

# 设置pip缓存目录
ENV PIP_CACHE_DIR=/cache/pip

# 只复制依赖相关文件
COPY requirements.txt .
COPY pyproject.toml .

# 设置中国镜像源并安装依赖
RUN echo "deb https://mirrors.tuna.tsinghua.edu.cn/debian/ bookworm main contrib non-free" > /etc/apt/sources.list && \
    pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --upgrade pip && \
    pip install --prefix=/install -r requirements.txt

# 构建阶段
FROM ${LITELLM_BUILD_IMAGE} AS builder
WORKDIR /app

# 安装构建依赖
RUN apt-get update && \
    apt-get install -y gcc python3-dev && \
    pip install --upgrade pip && \
    pip install build && \
    rm -rf /var/lib/apt/lists/*

# 复制缓存的依赖
COPY --from=builder-cache /install /usr/local

# 复制源代码
COPY . .

# 构建 Admin UI（只构建一次）
RUN chmod +x docker/build_admin_ui.sh && ./docker/build_admin_ui.sh

# 构建包
RUN rm -rf dist/* && python -m build

# 安装特定版本依赖
RUN pip install redisvl==0.0.7 --no-deps && \
    pip uninstall jwt PyJWT -y && \
    pip install PyJWT==2.9.0 --no-cache-dir

# 运行阶段
FROM ${LITELLM_RUNTIME_IMAGE} AS runtime

# 设置环境变量
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# 复制必要文件
COPY --from=builder /app/dist/*.whl /app/
COPY --from=builder /app/litellm/proxy/_experimental/out /app/ui/dist
COPY --from=builder /usr/local /usr/local
COPY schema.prisma /app/

WORKDIR /app

# 安装 litellm 包和生成 Prisma 客户端
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install *.whl && \
    prisma generate && \
    rm -rf /root/.cache/prisma && \
    rm -rf /root/.npm && \
    rm -rf /root/.cache/node && \
    rm -rf /usr/local/lib/node* && \
    rm -rf /usr/local/include/node* && \
    rm -rf /usr/local/bin/node* && \
    rm -rf /usr/local/bin/npm* && \
    rm -rf /tmp/npm* && \
    rm -rf /root/.node-gyp && \
    rm -f *.whl

EXPOSE 4000/tcp

ENTRYPOINT ["litellm"]
CMD ["--port", "4000"]
