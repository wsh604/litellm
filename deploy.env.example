# 阿里云镜像仓库配置
ALIYUN_REGISTRY="registry.example.com"
ALIYUN_USERNAME="your_username"
ALIYUN_PASSWORD="your_password"  # 阿里云镜像仓库密码

# OpenWrt配置
OPENWRT_HOST="192.168.1.1"
OPENWRT_PASSWORD="your_password"  # OpenWrt SSH密码

# LiteLLM配置
LITELLM_VERSION="1.6"  # 默认版本号
DATABASE_URL="file:/app/sqlite/litellm.db"
STORE_MODEL_IN_DB="True"
WUBAN_RPC_URL="http://host.docker.internal:9999/homate/api/v2/call/generic"
FILE_UPLOAD_BASE_DIR="/app/files"
PORT=4000

# API Keys (请替换为你的密钥)
OPENAI_API_KEY="sk-your-openai-api-key"
TOGETHER_API_KEY="your-together-api-key"
LITELLM_MASTER_KEY="your-master-key"
LITELLM_SALT_KEY="your-salt-key"
LITELLM_API_KEY="your-api-key"

# 部署配置
# 挂载目录配置
CONFIG_MOUNT_PATH="/homateos/data/app/litemllm/config/lite_config.yaml"
SQLITE_MOUNT_PATH="/homateos/data/app/litemllm/sqlite"
FILES_MOUNT_PATH="/homateos/data/app/litemllm/files"

# 容器配置
CONTAINER_NAME="litellm"
HEALTH_CHECK_MAX_RETRIES=12
HEALTH_CHECK_INTERVAL=5  # 秒 